// Rasoi — Canteen Management System data model.
// Money is stored as integer paise to avoid floating point errors.
// Role / status fields are strings validated in src/lib/domain/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection for the app
  directUrl = env("DATABASE_URL_UNPOOLED") // direct connection for migrations
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  rollNo        String?       @unique
  passwordHash  String
  role          String        @default("CUSTOMER") // CUSTOMER | KITCHEN | CASHIER | ADMIN
  walletBalance Int           @default(0)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  orders        Order[]       @relation("customerOrders")
  hostedGroups  GroupOrder[]
  groupSeats    GroupMember[]
  groupLines    GroupLine[]
  handled       Order[]       @relation("handledOrders")
  walletTxns    WalletTxn[]   @relation("walletOwner")
  auditLogs     AuditLog[]
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  sortOrder Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id          String      @id @default(cuid())
  name        String
  description String      @default("")
  pricePaise  Int
  isVeg       Boolean     @default(true)
  isAvailable Boolean     @default(true)
  stock       Int? // null = not tracked (made to order)
  prepMinutes Int         @default(10)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  groupLines  GroupLine[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
}

model Order {
  id            String      @id @default(cuid())
  token         Int
  businessDate  String // YYYY-MM-DD in IST; tokens restart daily
  channel       String // ONLINE | COUNTER
  status        String      @default("PLACED") // PLACED | PREPARING | READY | COLLECTED | CANCELLED
  customerName  String
  userId        String?
  user          User?       @relation("customerOrders", fields: [userId], references: [id])
  handledById   String?
  handledBy     User?       @relation("handledOrders", fields: [handledById], references: [id])
  pickupSlot    DateTime?
  subtotalPaise Int
  taxPaise      Int
  totalPaise    Int
  paymentMethod String // WALLET | UPI | CASH
  paymentStatus String      @default("PAID") // PAID | REFUNDED
  paymentRef    String?
  note          String      @default("")
  groupId       String?     @unique
  group         GroupOrder? @relation(fields: [groupId], references: [id])
  items         OrderItem[]
  placedAt      DateTime    @default(now())
  preparingAt   DateTime?
  readyAt       DateTime?
  collectedAt   DateTime?
  cancelledAt   DateTime?
  updatedAt     DateTime    @updatedAt

  @@unique([businessDate, token])
  @@index([status])
  @@index([userId])
  @@index([placedAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  name       String // snapshot so renamed items don't rewrite history
  unitPaise  Int
  qty        Int
  linePaise  Int

  @@index([orderId])
  @@index([menuItemId])
}

model WalletTxn {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("walletOwner", fields: [userId], references: [id])
  type         String // TOPUP | PAYMENT | REFUND
  amountPaise  Int // signed: +credit, -debit
  balanceAfter Int
  reference    String
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Single-row table holding operating rules the admin can change at runtime.
model CanteenSettings {
  id              Int     @id @default(1)
  openMinute      Int     @default(480) // minutes after IST midnight (08:00)
  closeMinute     Int     @default(1260) // 21:00
  slotMinutes     Int     @default(15)
  slotCapacity    Int     @default(20)
  acceptingOrders Boolean @default(true)
  taxBasisPoints  Int     @default(500) // 5% GST on canteen food
}

// A table order: friends share a code, each adds their own dishes and
// pays their own share from their wallet. Placed as one kitchen order.
model GroupOrder {
  id        String        @id @default(cuid())
  code      String        @unique
  hostId    String
  host      User          @relation(fields: [hostId], references: [id])
  status    String        @default("OPEN") // OPEN | PLACED | DISBANDED
  createdAt DateTime      @default(now())
  members   GroupMember[]
  lines     GroupLine[]
  order     Order?
}

model GroupMember {
  id         String     @id @default(cuid())
  groupId    String
  group      GroupOrder @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  ready      Boolean    @default(false)
  sharePaise Int? // set when the order is placed
  joinedAt   DateTime   @default(now())

  @@unique([groupId, userId])
}

model GroupLine {
  id         String     @id @default(cuid())
  groupId    String
  group      GroupOrder @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  menuItemId String
  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id])
  qty        Int

  @@unique([groupId, userId, menuItemId])
}
